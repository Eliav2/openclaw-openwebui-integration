# What the blocking end-to-end lane runs against: what the live install runs.
# Bump it in the same PR that makes the code work with a new release. The
# daily compat watch runs the same suite against whatever upstream ships next
# (open-webui:latest, openclaw@latest), so a break shows up before anyone bumps
# these. To try an upcoming release in a PR, run the E2E workflow by hand
# (Actions > E2E > Run workflow) with the release in `openclaw_version` or
# `owui_image`.
#
# OWUI_REF is the git tag matching OWUI_IMAGE: the vendored streaming-handler,
# frontend and CSS class fixtures are checked against it
# (scripts/check_owui_fixture.py, scripts/check_owui_frontend_fixture.py,
# scripts/owui_css.py).
OWUI_IMAGE=ghcr.io/open-webui/open-webui:v0.13.0
OWUI_REF=v0.13.0
OPENCLAW_VERSION=2026.10.10
# The oldest OpenClaw release the integration still supports. Its E2E lane
# ("E2E oldest") reports but never blocks a merge. Remove it, and this line,
# when the documented minimum moves up (ELI-356).
OPENCLAW_OLDEST_VERSION=2026.10.5
# A release being moved to gets OWUI_NEXT_IMAGE / OWUI_NEXT_REF /
# OPENCLAW_NEXT_VERSION here, for a manual run with owui_image or
# openclaw_version set to `next`; remove them with the PR that moves the pin.
# The fixture check also checks OWUI_NEXT_REF against the fixtures' _v<tag>
# copies (_v0_13_0 style) when it is set.
