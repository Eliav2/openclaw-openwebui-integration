# What the blocking end-to-end lane runs against. Keep this on the versions
# the integration is supported on; bump it in the same PR that makes the code
# work with a new release. The non-blocking "latest" lane and the daily
# compat watch run against whatever upstream ships next, so a break shows up
# before anyone bumps these.
#
# OWUI_REF is the git tag matching OWUI_IMAGE: the vendored streaming-handler,
# frontend and CSS class fixtures are checked against it
# (scripts/check_owui_fixture.py, scripts/check_owui_frontend_fixture.py,
# scripts/owui_css.py).
OWUI_IMAGE=ghcr.io/open-webui/open-webui:v0.12.5
OWUI_REF=v0.12.5
OPENCLAW_VERSION=2026.10.5
# The OpenClaw release the next upgrade targets. The blocking "E2E next" lane
# in ci.yml runs the suite against it (openclaw_version: next), so the code
# stays green on both until OPENCLAW_VERSION moves here.
OPENCLAW_NEXT_VERSION=2026.10.10-beta.1
