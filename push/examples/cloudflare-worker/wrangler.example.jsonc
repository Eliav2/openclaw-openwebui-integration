// Copy to wrangler.jsonc, fill in your hostname and keys, then `npx wrangler deploy`.
{
  "name": "open-webui-web-push",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  // Import the two scripts as text.
  "rules": [{ "type": "Text", "globs": ["**/oc-sw.js", "**/oc-push.js"], "fallthrough": true }],
  "routes": [
    { "pattern": "chat.example.com/oc-sw.js", "zone_name": "example.com" },
    { "pattern": "chat.example.com/static/loader.js", "zone_name": "example.com" }
  ],
  "vars": {
    "VAPID_PUBLIC_KEY": "<your VAPID public key, base64url>",
    "FUNCTION_ID": "openclaw_web_push"
  }
}
