{
  "models": {
    "providers": {
      "fake": null,
      "anthropic": {
        "baseUrl": "http://127.0.0.1:18999/v1",
        "apiKey": "local",
        "api": "openai-completions",
        "models": [
          {
            "id": "claude-opus-5-5",
            "name": "Claude Opus 5.5",
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 1000000
          },
          {
            "id": "claude-sonnet-5-5",
            "name": "Claude Sonnet 5.5",
            "input": [
              "text",
              "image"
            ]
          },
          {
            "id": "claude-haiku-5-5",
            "name": "Claude Haiku 5.5",
            "input": [
              "text",
              "image"
            ]
          }
        ]
      },
      "openai": {
        "baseUrl": "http://127.0.0.1:18999/v1",
        "apiKey": "local",
        "api": "openai-completions",
        "models": [
          {
            "id": "gpt-5.5",
            "name": "GPT-5.5",
            "input": [
              "text",
              "image"
            ]
          }
        ]
      },
      "google": {
        "baseUrl": "http://127.0.0.1:18999/v1",
        "apiKey": "local",
        "api": "openai-completions",
        "models": [
          {
            "id": "gemini-3.1-pro-preview",
            "name": "Gemini 3.1 Pro",
            "input": [
              "text",
              "image"
            ]
          }
        ]
      },
      "deepseek": {
        "baseUrl": "http://127.0.0.1:18999/v1",
        "apiKey": "local",
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-v4-flash",
            "name": "DeepSeek V4 Flash"
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "anthropic/claude-opus-5-5"
      },
      "modelPolicy": {
        "allow": [
          "anthropic/claude-opus-5-5",
          "anthropic/claude-sonnet-5-5",
          "anthropic/claude-haiku-5-5",
          "openai/gpt-5.5",
          "google/gemini-3.1-pro-preview",
          "deepseek/deepseek-v4-flash"
        ]
      }
    }
  },
  "plugins": {
    "load": {
      "paths": [
        "@SCREENSHOTS_DIR@/sample-usage"
      ]
    },
    "entries": {
      "screenshot-sample-usage": {
        "enabled": true
      }
    }
  }
}
