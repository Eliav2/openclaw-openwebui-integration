{
  "models": {
    "providers": {
      "fake": null,
      "local": {
        "baseUrl": "http://127.0.0.1:18999/v1",
        "apiKey": "local",
        "api": "openai-completions",
        "models": [
          {
            "id": "nova",
            "name": "Nova",
            "contextWindow": 200000,
            "maxTokens": 8192,
            "input": [
              "text",
              "image"
            ]
          },
          {
            "id": "nova-mini",
            "name": "Nova Mini",
            "contextWindow": 200000,
            "maxTokens": 8192
          },
          {
            "id": "nova-pro",
            "name": "Nova Pro",
            "contextWindow": 200000,
            "maxTokens": 8192
          },
          {
            "id": "nova-vision",
            "name": "Nova Vision",
            "contextWindow": 200000,
            "maxTokens": 8192,
            "input": [
              "text",
              "image"
            ]
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "local/nova"
      }
    }
  },
  "plugins": {
    "load": {
      "paths": [
        "@SCREENSHOTS_DIR@/sample-usage"
      ]
    }
  }
}
